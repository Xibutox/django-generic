*.py[cod]
*.egg-info/
build/
dist/

.venv/
venv/
env/

.pytest_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
# The browser tests' screenshots of what failed (--output).
test-results/

*.sqlite3
demo.sqlite3
