# DJANGO_LOG_FILE=logs/app.log, its rotated copies and its lock.
logs/
# Celery Beat's own state file, written where it is started.
celerybeat-schedule*
staticfiles/
.env
# The production stack's secrets: docker/prod.env.example is the one to
# commit.
docker/prod.env
# Certificates and certbot's challenges for the nginx stack: the server's.
docker/nginx/certs/
docker/nginx/acme/

.idea/
# Claude Code's own per-machine settings (the preview server's command
# names this machine's venv). CLAUDE.md and ai/ are the shared part.
.claude/
# The shared VS Code setup is committed (debugging: debug.py); the rest
# of the folder is each developer's own.
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
