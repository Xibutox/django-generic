# The production stack's settings. Copy this file to docker/prod.env,
# fill it in, and never commit the copy (.gitignore and .dockerignore
# already leave it out):
#
#   cp docker/prod.env.example docker/prod.env
#   docker compose -f docker/docker-compose.prod.yml --env-file docker/prod.env up -d --build
#
# An empty line means "not given": the setting keeps its default.

# -- Required -------------------------------------------------------------

# Long and random, and never the one of another site:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# The names the site answers to, comma-separated.
DJANGO_ALLOWED_HOSTS=desk.example.com

# Letters and digits, or percent-encode it: it becomes part of a URL.
POSTGRES_PASSWORD=

# -- The address ------------------------------------------------------------

# What Caddy serves and obtains a certificate for. ":80" serves plain
# HTTP - to try the stack on localhost, with DJANGO_HTTPS=0 and
# DJANGO_ALLOWED_HOSTS=localhost.
SITE_ADDRESS=desk.example.com

# 1 when the site is served over HTTPS: secure cookies, the redirect to
# HTTPS, HSTS. 0 only to try the stack over plain HTTP.
DJANGO_HTTPS=1

# Full origins, scheme included, for forms posted across origins.
DJANGO_CSRF_TRUSTED_ORIGINS=https://desk.example.com

# The site's address, for the links in the mails it sends.
DJANGO_SITE_URL=https://desk.example.com

# HSTS: one hour by default. Raise it (31536000 is a year) once HTTPS
# works everywhere the site is reached - a browser that has seen it will
# refuse plain HTTP for that long.
DJANGO_HSTS_SECONDS=
DJANGO_HSTS_SUBDOMAINS=
DJANGO_HSTS_PRELOAD=

# -- Database -----------------------------------------------------------------

POSTGRES_DB=generic
POSTGRES_USER=generic

# -- Mail ---------------------------------------------------------------------
#
# Without EMAIL_HOST, the notifications that go by mail are written to
# the log instead.

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=desk@example.com

# -- nginx (docker-compose.prod-nginx.yml) -------------------------------------
#
# The Caddy stack ignores these. nginx does not obtain certificates: give
# it the server's. NGINX_CERTS_DIR is mounted on /etc/nginx/certs, and
# NGINX_CERT / NGINX_CERT_KEY are the files in it, as seen from inside:
#   NGINX_CERTS_DIR=/etc/letsencrypt
#   NGINX_CERT=/etc/nginx/certs/live/desk.example.com/fullchain.pem
#   NGINX_CERT_KEY=/etc/nginx/certs/live/desk.example.com/privkey.pem
# NGINX_MODE=http serves plain HTTP, to try it with DJANGO_HTTPS=0.
NGINX_MODE=https
SERVER_NAME=desk.example.com
NGINX_CERTS_DIR=
NGINX_CERT=
NGINX_CERT_KEY=

# -- An nginx already on the server (docker-compose.host-nginx.yml) -----------
#
# Daphne is published on 127.0.0.1:WEB_PORT, and the static files are
# copied to STATIC_EXPORT_DIR, for the server's nginx
# (docker/nginx/host-site.conf.example).
WEB_PORT=8000
STATIC_EXPORT_DIR=

# -- Errors and logs ----------------------------------------------------------
#
# Who is mailed an unexpected error, with its traceback: comma-separated
# addresses. Once per error every ten minutes, with a count of the ones
# held back. Empty, errors are only logged - and `check --deploy` says so.
DJANGO_ADMINS=

# The least a record needs to be logged: DEBUG, INFO, WARNING, ERROR.
# Everything goes to standard output (`docker compose ... logs web`) and
# to /app/logs/app.log in the app-logs volume:
#   docker compose -f docker/docker-compose.prod.yml --env-file docker/prod.env exec web tail -f logs/app.log
DJANGO_LOG_LEVEL=INFO

# -- Running ------------------------------------------------------------------

HTTP_PORT=80
HTTPS_PORT=443
