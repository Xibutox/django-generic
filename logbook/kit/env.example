# Copy to .env and fill in. Never commit .env.

# -- The site --------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# The names the site is reached by, comma-separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The full addresses, when it is reached through a name or a proxy:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://logbook.example.org
LOGBOOK_PORT=4243

# -- The database ------------------------------------------------------
POSTGRES_PASSWORD=change-me

# -- The first administrator (created on the first start) -------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=

# -- The key figures API (planner/api/kpi/) -----------------------------
# Empty: open, as the old planner's. Set: callers send
# "Authorization: Token <value>" or ?token=<value>.
LOGBOOK_KPI_TOKEN=

# -- COMET and DES, read by sync_kpi -------------------------------------
# The roots of the two APIs, as in the old planner's interfaces/.
COMET_API_URL=
COMET_USERNAME=
COMET_PASSWORD=
DES_API_URL=
DES_USERNAME=
DES_PASSWORD=
# 1 checks the tools' certificates. If they are signed by an internal
# authority, give its file (mounted in the container) rather than 0.
KPI_SYNC_VERIFY_TLS=1
# KPI_SYNC_CA_BUNDLE=/certs/internal-ca.pem
KPI_SYNC_EVERY=3600
