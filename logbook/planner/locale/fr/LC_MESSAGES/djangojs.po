msgid "Text"
msgstr "Texte"

msgid "Heading"
msgstr "Titre"

msgid "Bullet"
msgstr "Puce"

msgid "To-do"
msgstr "Case à cocher"

msgid "FNC task - a ticket"
msgstr "Tâche FNC - un ticket"

msgid "DM task - an evolution"
msgstr "Tâche DM - une évolution"

msgid "The note could not be loaded."
msgstr "La note n’a pas pu être chargée."

msgid "Title"
msgstr "Titre"

msgid "Start a line with # for a heading, - for a bullet, [] for a to-do, /fnc or /dm for a task. Tab indents."
msgstr "Commencez une ligne par # pour un titre, - pour une puce, [] pour une case à cocher, /fnc ou /dm pour une tâche. Tab met en retrait."

msgid "Saved"
msgstr "Enregistrée"

msgid "Done"
msgstr "Fait"

msgid "Line"
msgstr "Ligne"

msgid "Kind of line: %(kind)s"
msgstr "Type de ligne : %(kind)s"

msgid "Write something, or /fnc a task..."
msgstr "Écrivez quelque chose, ou /fnc une tâche..."

msgid "new task, saved soon"
msgstr "nouvelle tâche, bientôt enregistrée"

msgid "Open the task"
msgstr "Ouvrir la tâche"

msgid "Status"
msgstr "Statut"

msgid "Time spent"
msgstr "Temps passé"

msgid "Stop the timer"
msgstr "Arrêter le chronomètre"

msgid "Start the timer"
msgstr "Lancer le chronomètre"

msgid "Turn %(task)s back into text?"
msgstr "Refaire de %(task)s une ligne de texte ?"

msgid "The task is kept if time was logged on it or work started; otherwise it is deleted."
msgstr "La tâche est gardée si du temps y a été saisi ou si le travail a commencé ; sinon elle est supprimée."

msgid "Make it text"
msgstr "En faire du texte"

msgid "Not saved yet"
msgstr "Pas encore enregistrée"

msgid "Saving..."
msgstr "Enregistrement..."

msgid "Saved at %(time)s"
msgstr "Enregistrée à %(time)s"

msgid "The note could not be saved."
msgstr "La note n’a pas pu être enregistrée."

msgid "The task could not be changed."
msgstr "La tâche n’a pas pu être modifiée."

msgid "The timer runs on %(task)s."
msgstr "Le chronomètre tourne sur %(task)s."

msgid "Time logged on %(task)s."
msgstr "Temps saisi sur %(task)s."

msgid "The timer could not be changed."
msgstr "Le chronomètre n’a pas pu être modifié."

msgid "AUT task - a meeting, support"
msgstr "Tâche AUT - une réunion, du support"

msgid "Start a line with # for a heading, - for a bullet, [] for a to-do, /fnc, /dm or /aut for a task. Tab indents."
msgstr "Commencez une ligne par # pour un titre, - pour une puce, [] pour une case à cocher, /fnc, /dm ou /aut pour une tâche. Tab indente."

msgid "Criticality"
msgstr "Criticité"

msgid "A new line; Shift+Enter breaks the line inside it"
msgstr "Une nouvelle ligne ; Maj+Entrée revient à la ligne dans la même"

msgid "Indent, outdent"
msgstr "Décaler à droite, à gauche"

msgid "Move the line, with the lines indented under it (Ctrl+Shift+↑ / ↓ too)"
msgstr "Déplacer la ligne, avec les lignes décalées sous elle (Ctrl+Maj+↑ / ↓ aussi)"

msgid "At the start or end of a line: select whole lines"
msgstr "Au début ou à la fin d'une ligne : sélectionner des lignes entières"

msgid "Twice: select every line"
msgstr "Deux fois : sélectionner toutes les lignes"

msgid "Copy, cut, paste lines - from OneNote, Word, Outlook too"
msgstr "Copier, couper, coller des lignes - depuis OneNote, Word, Outlook aussi"

msgid "Remove the selected lines"
msgstr "Retirer les lignes sélectionnées"

msgid "Undo a paste, a move, a removal"
msgstr "Annuler un collage, un déplacement, un retrait"

msgid "Tick or untick a to-do"
msgstr "Cocher ou décocher une case"

msgid "Save now"
msgstr "Enregistrer tout de suite"

msgid "Let go of the selection"
msgstr "Abandonner la sélection"

msgid "Lines"
msgstr "Lignes"

msgid "Note tools"
msgstr "Outils de la note"

msgid "Add a line: %(kind)s"
msgstr "Ajouter une ligne : %(kind)s"

msgid "Copy the selected lines, or the whole note"
msgstr "Copier les lignes sélectionnées, ou toute la note"

msgid "Attach the selected lines, or the current one, to a task"
msgstr "Joindre les lignes sélectionnées, ou la ligne en cours, à une tâche"

msgid "Keyboard shortcuts"
msgstr "Raccourcis clavier"

msgid "Drag to move; click to select"
msgstr "Glisser pour déplacer ; cliquer pour sélectionner"

msgid "Click to select"
msgstr "Cliquer pour sélectionner"

msgid "Add a line below"
msgstr "Ajouter une ligne en dessous"

msgid "Move up"
msgstr "Monter"

msgid "Move down"
msgstr "Descendre"

msgid "Select the line"
msgstr "Sélectionner la ligne"

msgid "Attach to a task..."
msgstr "Joindre à une tâche..."

msgid "Remove the line"
msgstr "Retirer la ligne"

msgid "The lines could not be copied: select them and press Ctrl+C."
msgstr "Les lignes n'ont pas pu être copiées : sélectionnez-les et appuyez sur Ctrl+C."

msgid "With them go the lines of %(tasks)s: each task is kept if time was logged on it or work started; otherwise it is deleted."
msgstr "Avec elles partent les lignes de %(tasks)s : chaque tâche est gardée si du temps y a été saisi ou si le travail a commencé ; sinon elle est supprimée."

msgid "Nothing to attach: write or select the lines first."
msgstr "Rien à joindre : écrivez ou sélectionnez d'abord les lignes."

msgid "Attach to a task"
msgstr "Joindre à une tâche"

msgid "Attach"
msgstr "Joindre"

msgid "Task"
msgstr "Tâche"

msgid "Search by reference or title"
msgstr "Chercher par référence ou par titre"

msgid "Tasks"
msgstr "Tâches"

msgid "No task found."
msgstr "Aucune tâche trouvée."

msgid "The tasks could not be loaded."
msgstr "Les tâches n'ont pas pu être chargées."

msgid "Added to the specification of %(task)s."
msgstr "Ajouté à la spécification de %(task)s."

msgid "The text could not be attached."
msgstr "Le texte n'a pas pu être joint."

msgid "%(count)s line pasted."
msgid_plural "%(count)s lines pasted."
msgstr[0] "%(count)s ligne collée."
msgstr[1] "%(count)s lignes collées."

msgid "%(count)s line copied."
msgid_plural "%(count)s lines copied."
msgstr[0] "%(count)s ligne copiée."
msgstr[1] "%(count)s lignes copiées."

msgid "%(count)s line selected"
msgid_plural "%(count)s lines selected"
msgstr[0] "%(count)s ligne sélectionnée"
msgstr[1] "%(count)s lignes sélectionnées"

msgid "%(count)s line cut."
msgid_plural "%(count)s lines cut."
msgstr[0] "%(count)s ligne coupée."
msgstr[1] "%(count)s lignes coupées."

msgid "%(count)s line removed."
msgid_plural "%(count)s lines removed."
msgstr[0] "%(count)s ligne retirée."
msgstr[1] "%(count)s lignes retirées."

msgid "Remove %(count)s line?"
msgid_plural "Remove %(count)s lines?"
msgstr[0] "Retirer %(count)s ligne ?"
msgstr[1] "Retirer %(count)s lignes ?"

msgid "%(count)s line moved."
msgid_plural "%(count)s lines moved."
msgstr[0] "%(count)s ligne déplacée."
msgstr[1] "%(count)s lignes déplacées."

msgid "This line is added to the specification of the task you pick, with the note's title and today's date."
msgid_plural "These %(count)s lines are added to the specification of the task you pick, with the note's title and today's date."
msgstr[0] "Cette ligne est ajoutée à la spécification de la tâche choisie, avec le titre de la note et la date du jour."
msgstr[1] "Ces %(count)s lignes sont ajoutées à la spécification de la tâche choisie, avec le titre de la note et la date du jour."

msgid "The server's answer could not be read: reload the page, or sign in again."
msgstr "La réponse du serveur n'a pas pu être lue : rechargez la page, ou reconnectez-vous."

msgid "The server's answer could not be read: the note is kept here and sent again in a moment."
msgstr "La réponse du serveur n'a pas pu être lue : la note est gardée ici et renvoyée dans un instant."

msgid "An existing task"
msgstr "Une tâche existante"

msgid "Add the text to its specification"
msgstr "Ajouter le texte à sa spécification"

msgid "Put the task in the note"
msgstr "Mettre la tâche dans la note"

msgid "Put the task you pick in this note, as a task line - or add the selected lines to its specification."
msgstr "Mettez la tâche choisie dans cette note, comme une ligne de tâche - ou ajoutez les lignes sélectionnées à sa spécification."

msgid "Text to add: %(count)s line"
msgid_plural "Text to add: %(count)s lines"
msgstr[0] "Texte à ajouter : %(count)s ligne"
msgstr[1] "Texte à ajouter : %(count)s lignes"

msgid "%(task)s is already in this note."
msgstr "%(task)s est déjà dans cette note."

msgid "%(task)s is a line of the note \"%(note)s\": it can take text, and stays there."
msgstr "%(task)s est une ligne de la note « %(note)s » : elle peut recevoir du texte, et y reste."

msgid "in this note"
msgstr "dans cette note"

msgid "in %(note)s"
msgstr "dans %(note)s"

msgid "The server's answer could not be read: the text may not have been added."
msgstr "La réponse du serveur n'a pas pu être lue : le texte n'a peut-être pas été ajouté."

msgid "%(task)s put in the note."
msgstr "%(task)s mise dans la note."

msgid "%(task)s, in the note once saved"
msgstr "%(task)s, dans la note une fois enregistrée"

msgid "An existing task: put it in the note, or add the selected lines to it"
msgstr "Une tâche existante : la mettre dans la note, ou lui ajouter les lignes sélectionnées"

msgid "An existing task..."
msgstr "Une tâche existante..."

msgid "Due date"
msgstr "Échéance"

msgid "Late: due %(date)s - change"
msgstr "En retard : échéance le %(date)s - modifier"

msgid "Due %(date)s - change"
msgstr "Échéance le %(date)s - modifier"

msgid "Set a due date"
msgstr "Fixer une échéance"

msgid "Assignee"
msgstr "Responsable"

msgid "Assignee: %(name)s"
msgstr "Responsable : %(name)s"
