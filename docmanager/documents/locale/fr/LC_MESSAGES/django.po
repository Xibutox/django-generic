msgid "%(name)s is not a Word file (.docx or .dotx). An older .doc file has to be saved as .docx first."
msgstr "%(name)s n'est pas un fichier Word (.docx ou .dotx). Un ancien fichier .doc doit d'abord être enregistré en .docx."

#, python-format
msgid "%(name)s is too large once unpacked."
msgstr "%(name)s est trop volumineux une fois décompressé."

#, python-format
msgid "%(name)s is not a Word file (.docx or .dotx); a file with macros (.docm, .dotm) is not accepted either."
msgstr "%(name)s n'est pas un fichier Word (.docx ou .dotx) ; un fichier avec macros (.docm, .dotm) n'est pas accepté non plus."

#, python-format
msgid "%(name)s could not be read as a Word file."
msgstr "%(name)s n'a pas pu être lu comme un fichier Word."

msgid "Files to merge"
msgstr "Fichiers à fusionner"

msgid "Move up"
msgstr "Monter"

msgid "Move down"
msgstr "Descendre"

