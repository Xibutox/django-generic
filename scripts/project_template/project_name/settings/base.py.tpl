"""What {{ title }} is, whichever machine it runs on.

Everything here is the same in development and in production: the
apps, the middleware, the templates, the languages, the framework's own
configuration. What differs - the database, the secrets, DEBUG, the
security headers - is in ``dev.py`` and ``prod.py``, which start with
``from .base import *``.

Generated by django-generic's ``scripts/new_project.py``; the helpers
below are the ones of its ``example_project/settings/base.py``.
"""

import os
from pathlib import Path
from urllib.parse import unquote, urlparse

import django
from django.core.exceptions import ImproperlyConfigured
